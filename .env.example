# Admin authentication (required for /admin access)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Image storage — leave unset for local dev (defaults to Static/images)
# On Railway, set to the mounted volume path:
# IMAGES_DIR=/data/images

# Admin filesystem imports are restricted to this directory. Relative paths
# submitted to /admin/import-path are resolved beneath it.
# IMPORT_ROOT=/data/images/imports

# OpenAI — for AI-powered metadata generation
MY_OPENAI_API_KEY=
OPENAI_IMAGE_METADATA_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30

# Canonical site URL for SEO (sitemap, robots.txt, canonical link tags)
# SITE_URL=https://artazzen.com

# Upload limit
MAX_UPLOAD_SIZE_MB=50

# Print masters — opt-in AI upscaling to 300 DPI (see PRINT_WORKFLOW.md).
# Off by default; the manual button on the review page still works whenever
# a backend is configured.
# UPSCALE_ENABLED=0
# UPSCALE_SCALE=4            # 2-4
# UPSCALE_MODEL=general      # general | digital
# UPSCALE_BACKEND=           # replicate | binary | torch (default: auto-detect)
# Hosted backend (recommended on Railway; no heavy dependencies)
# REPLICATE_API_TOKEN=
# REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan
# REPLICATE_UPSCALE_VERSION=  # optional version pin; latest resolved when unset
# REPLICATE_TIMEOUT_SECONDS=300
# Self-hosted binary backend (the engine Upscayl bundles)
# REALESRGAN_BIN=/path/to/realesrgan-ncnn-vulkan

# Server port (set automatically by Railway)
# PORT=8000
