{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/ImageSidecar.schema.json",
  "title": "Image Sidecar Metadata",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "ai_generated": {
      "type": "boolean",
      "description": "Indicates whether AI generated the current title or description.",
      "default": false
    },
    "ai_details": {
      "type": "object",
      "default": {},
      "properties": {
        "provider": {
          "type": "string",
          "default": ""
        },
        "model": {
          "type": "string",
          "default": ""
        },
        "prompt": {
          "type": "string",
          "default": ""
        },
        "response_id": {
          "type": "string",
          "default": ""
        },
        "finish_reason": {
          "type": "string",
          "default": ""
        },
        "created": {
          "type": "number",
          "default": 0
        },
        "attempted_at": {
          "type": "number",
          "default": 0
        },
        "status": {
          "type": "string",
          "default": ""
        },
        "error": {
          "type": "string",
          "default": ""
        },
        "error_body": {
          "type": "string",
          "default": ""
        },
        "raw_response": {
          "type": "object",
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "hidden"],
      "default": "pending",
      "description": "Curation status of the artwork."
    },
    "reviewed": {
      "type": "boolean",
      "default": false,
      "description": "Deprecated: use status field instead. Kept for backwards compatibility."
    },
    "detected_at": {
      "type": "number",
      "description": "Unix epoch seconds when the image was first detected.",
      "default": 0
    },
    "caption": {
      "type": "string",
      "default": "",
      "description": "Short gallery caption for the artwork."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Descriptive tags for categorization and search."
    },
    "artist": {
      "type": "string",
      "default": "",
      "description": "Artist or creator name."
    },
    "author": {
      "type": "string",
      "default": "",
      "description": "Deprecated: use artist field instead. Kept for backwards compatibility."
    },
    "copyright": {
      "type": "string",
      "default": "",
      "description": "Copyright or license information."
    },
    "collection": {
      "type": "string",
      "default": "",
      "description": "Deprecated: use the collections array instead. Kept for backwards compatibility."
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "default": [],
      "description": "Slugs of collections this artwork belongs to. Authoritative membership record; collection metadata (title, nesting, order) lives in .curation/collections.json."
    },
    "series": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "default": [],
      "description": "Ids of series this artwork appears in. Denormalized mirror; the series registry (.curation/series.json) is authoritative for membership and order."
    },
    "ai_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["title", "caption", "description", "tags"]
      },
      "default": [],
      "description": "Which metadata fields were generated or last updated by AI."
    },
    "print_master": {
      "type": "object",
      "description": "AI-upscaled 300 DPI print master derived from this image.",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "description": "One of: '', 'pending', 'processing', 'done', 'error'.",
          "default": ""
        },
        "file": {
          "type": "string",
          "description": "Path of the master relative to the images directory.",
          "default": ""
        },
        "url_path": {
          "type": "string",
          "default": ""
        },
        "width": {
          "type": "integer",
          "default": 0
        },
        "height": {
          "type": "integer",
          "default": 0
        },
        "dpi": {
          "type": "integer",
          "default": 300
        },
        "scale": {
          "type": "integer",
          "default": 4
        },
        "model": {
          "type": "string",
          "default": ""
        },
        "backend": {
          "type": "string",
          "default": ""
        },
        "created": {
          "type": "number",
          "default": 0
        },
        "error": {
          "type": "string",
          "default": ""
        }
      }
    }
  },
  "required": [
    "title",
    "description",
    "ai_generated",
    "ai_details",
    "status",
    "detected_at"
  ]
}
