{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI model catalog",
  "description": "Models offered in the admin AI settings, with list prices and the reasoning efforts each one accepts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "as_of",
    "currency",
    "source",
    "estimated_input_tokens_per_image",
    "models"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date the prices and effort lists were last checked against the provider's pages."
    },
    "currency": { "type": "string", "const": "USD" },
    "source": {
      "type": "string",
      "description": "Page the model list was taken from."
    },
    "estimated_input_tokens_per_image": {
      "type": "integer",
      "minimum": 1,
      "description": "Input tokens assumed per request (prompt plus one image) when estimating cost."
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "input_price_per_mtok",
          "output_price_per_mtok",
          "reasoning_efforts",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Model ID sent to the API."
          },
          "name": { "type": "string", "minLength": 1 },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "One or two sentences shown under the model selector."
          },
          "input_price_per_mtok": {
            "type": "number",
            "minimum": 0,
            "description": "List price per 1M input tokens."
          },
          "output_price_per_mtok": {
            "type": "number",
            "minimum": 0,
            "description": "List price per 1M output tokens. Reasoning tokens are billed as output."
          },
          "reasoning_efforts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "contains": { "const": "low" },
            "items": {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "description": "Efforts the app lets the admin choose for this model. Any other effort falls back to low, so every model must list it."
          },
          "source": {
            "type": "string",
            "description": "The provider's page for this model."
          }
        }
      }
    }
  }
}
